# ==============================================================================
# FinancialRAG - Template de Variables de Entorno (.env.example)
# Copia este archivo como .env y ajusta los valores según tu entorno:
#   cp .env.example .env
# ==============================================================================

# Django Core Settings
SECRET_KEY=change-this-insecure-key-for-production-use
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Default: SQLite)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Opcional para PostgreSQL en producción:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=financialrag_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# AI & LLM Providers (Ollama Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Machine Learning Model Configuration
ACTIVE_MODEL_VERSION=variant_c_sentiment_augmented
